"""Admin-Bereich: Systemkonfiguration (SMTP + Testmail + Supabase-Info + Spam-Hinweise),
Benutzerverwaltung (PW-Reset, E-Mail), Daten ansehen. Admins: Secrets oder 'christian mayerhofer'."""
import hashlib
import os

import pandas as pd
import streamlit as st

from database import DatabaseError
from database.system_config import load_system_config, save_system_config
from database.users import all_usernames, update_password, set_user_email
from database.settings import load_settings, load_settings as _ls
from database.fahrzeuge import load_fahrzeuge
from services.email import send_reset_email, get_smtp_settings

ADMIN_FALLBACK = ["christian mayerhofer"]  # wie Original


def _is_admin(username) -> bool:
    try:
        extra = [a.strip().lower() for a in str(st.secrets.get("ADMIN_USERNAMES", "")).split(",") if a.strip()]
    except Exception:
        extra = []
    return username in (extra + [a.lower() for a in ADMIN_FALLBACK])


def render(username):
    st.subheader("🔑 Admin-Bereich")
    if not _is_admin(username):
        st.info("Kein Admin-Zugang.")
        return
    tab_cfg, tab_users, tab_data = st.tabs([
        "⚙️ Systemkonfiguration", "👥 Benutzerverwaltung", "📊 Daten ansehen"])

    # ---------- TAB 1 ----------
    with tab_cfg:
        st.subheader("📧 E-Mail / SMTP Konfiguration")
        st.caption("Zugangsdaten für den E-Mail-Versand (Passwort-Reset). Ohne Werte werden "
                   "Umgebungsvariablen/Secrets verwendet.")
        try:
            current_config = load_system_config()
            current_smtp = get_smtp_settings()
        except DatabaseError as e:
            st.error(str(e)); return
        sc1, sc2 = st.columns(2)
        with sc1:
            cfg_server = st.text_input("SMTP Server", value=current_smtp.get("server", ""),
                                       help="z. B. mail.gmx.net, smtp.gmail.com")
            cfg_port = st.text_input("SMTP Port", value=current_smtp.get("port", "465"),
                                     help="465 = SSL (GMX), 587 = STARTTLS")
        with sc2:
            cfg_user = st.text_input("SMTP Benutzer / E-Mail", value=current_smtp.get("user", ""))
            cfg_password = st.text_input("SMTP Passwort", value="", type="password",
                                         help="App-Passwort verwenden, nicht das normale Login-Passwort!")
        cfg_from = st.text_input("Absendername", value=current_smtp.get("from_name", "Fahrtenbuch System"))
        st.caption(f"Aktuelle SMTP-Quelle: **{'Datenbank' if current_config.get('smtp_server') else 'Umgebungsvariablen/Secrets' if os.environ.get('SMTP_SERVER') or _secret('SMTP_SERVER') else 'nicht konfiguriert'}**")
        col_s, col_t = st.columns(2)
        with col_s:
            if st.button("💾 SMTP-Einstellungen speichern"):
                save_data = {"smtp_server": cfg_server.strip(), "smtp_port": cfg_port.strip(),
                             "smtp_user": cfg_user.strip(), "smtp_from_name": cfg_from.strip(),
                             "smtp_password": cfg_password or current_config.get("smtp_password", "")}
                if save_system_config(save_data):
                    st.success("SMTP-Einstellungen gespeichert!")
                    st.rerun()
        with col_t:
            test_email = st.text_input("Test-E-Mail an", help="Eine Test-Nachricht an diese Adresse senden.")
            if st.button("📧 Test-E-Mail senden"):
                if not test_email or "@" not in test_email:
                    st.error("Bitte eine gültige E-Mail-Adresse eingeben.")
                else:
                    test_smtp = {"server": cfg_server.strip() or current_smtp.get("server", ""),
                                 "port": cfg_port.strip() or current_smtp.get("port", "465"),
                                 "user": cfg_user.strip() or current_smtp.get("user", ""),
                                 "password": cfg_password or current_smtp.get("password", ""),
                                 "from_name": cfg_from.strip() or current_smtp.get("from_name", "Fahrtenbuch System")}
                    if send_reset_email(test_email, "TEST-PASSWORT-1234", smtp_settings=test_smtp):
                        st.success(f"Test-E-Mail erfolgreich an {test_email} gesendet! "
                                   "Prüfe Posteingang und Spam-Ordner.")
                    else:
                        st.error("Test-E-Mail konnte NICHT gesendet werden. Prüfe SMTP-Einstellungen und App-Passwort.")
        st.markdown("---")
        st.subheader("🗄️ Supabase-Verbindung (nur Anzeige)")
        url_disp = os.environ.get("SUPABASE_URL") or _secret("SUPABASE_URL") or "(nicht gesetzt)"
        raw_key = os.environ.get("SUPABASE_KEY") or _secret("SUPABASE_KEY") or ""
        key_disp = (raw_key[:6] + "••••••••" + raw_key[-4:]) if len(raw_key) > 10 else "(nicht gesetzt)"
        k1, k2 = st.columns(2)
        k1.text_input("Supabase URL", value=url_disp, disabled=True)
        k2.text_input("Supabase Key", value=key_disp, disabled=True)
        with st.expander("ℹ️ Hinweise: E-Mails landen im Spam – was tun?"):
            st.markdown("""**Code-Ebene (bereits optimiert):** X-Priority entfernt, Reply-To gesetzt,
korrekte Message-ID, nur Plain-Text, professioneller Absendername.

**Server-/Domain-Ebene (wichtigste Maßnahmen):**
1. **SPF-Record**: DNS-Eintrag, der deiner Domain erlaubt, über deinen SMTP-Server zu senden
2. **DKIM-Signatur**: digitale Signatur (beim Mail-Provider einrichten)
3. **DMARC-Policy**: sagt Empfängern, wie mit E-Mails ohne SPF/DKIM umzugehen ist

**Empfehlung:** Für GMX SPF/DKIM/DMARC über GMX-Admin einrichten. Bessere Alternative:
ein Transaktions-E-Mail-Dienst wie **SendGrid**, **Mailgun** oder **Resend** (Spam-Einstellungen fertig konfiguriert).""")

    # ---------- TAB 2 ----------
    with tab_users:
        st.subheader("Passwort eines Users zurücksetzen")
        try:
            users = all_usernames()
        except DatabaseError as e:
            st.error(str(e)); return
        if users:
            sel = st.selectbox("User auswählen", users)
            new_pw = st.text_input("Neues Passwort für diesen User", type="password")
            if st.button("🔑 Passwort jetzt ändern"):
                if new_pw:
                    update_password(sel, new_pw, force_change=True)
                    st.success(f"Passwort für **{sel}** geändert. User muss bei nächstem Login "
                               "ein neues Passwort setzen.")
                else:
                    st.warning("Bitte ein neues Passwort eingeben.")
            st.markdown("---")
            st.subheader("📧 E-Mail-Adresse verwalten (für Passwort-Reset)")
            from database.users import get_user_email
            cur = get_user_email(sel)
            ne = st.text_input("E-Mail-Adresse eintragen/ändern", value=cur)
            if st.button("💾 E-Mail speichern"):
                if ne and "@" in ne:
                    set_user_email(sel, ne)
                    st.success(f"E-Mail für **{sel}** gespeichert.")
                    st.rerun()
                else:
                    st.error("Bitte eine gültige E-Mail-Adresse ein (muss ein @ enthalten).")
        else:
            st.info("Keine Benutzer vorhanden.")

    # ---------- TAB 3 ----------
    with tab_data:
        try:
            users = all_usernames()
        except DatabaseError as e:
            st.error(str(e)); return
        if users:
            sel = st.selectbox("User-Daten anzeigen", users, key="admin_data_user")
            st.subheader(f"📊 Daten von {sel}")
            c1, c2 = st.columns(2)
            with c1:
                st.write("**Stammdaten:**")
                try:
                    s = load_settings(sel)
                    st.json(s) if s else st.info("Noch keine Stammdaten hinterlegt.")
                except DatabaseError as e:
                    st.error(str(e))
            with c2:
                st.write("**Fahrzeuge:**")
                try:
                    fz = load_fahrzeuge(sel)
                    st.dataframe(fz) if not fz.empty else st.info("Noch keine Fahrzeuge hinterlegt.")
                except DatabaseError as e:
                    st.error(str(e))


def _secret(key):
    try:
        return st.secrets.get(key, "")
    except Exception:
        return ""